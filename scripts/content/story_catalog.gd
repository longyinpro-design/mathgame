static func scene(id: String) -> Dictionary:
	var row: Array = SCENES.get(id,[])
	var level = id.trim_prefix("pre_").trim_prefix("post_").trim_prefix("puzzle_")
	if row.is_empty() and SETUPS.has(level) and id.begins_with("pre_"):
		var setup: Array = SETUPS[level]
		row = [setup[0],preload("res://scripts/content/content_catalog.gd").region_for(level),setup[1],setup[2],setup[3],"puzzle_"+level,"arrival"]
	if row.is_empty() and SETUPS.has(level) and id.begins_with("post_"):
		var reaction: String = REACTIONS[level]
		var speaker = reaction.get_slice("：",0)
		row = [{"FL03":"村仓重新分粮","FL04":"灯照回家的路","FL05":"第一台机器转动了","FL06":"育苗机有了名字","FL07":"磨坊全面开工","FL08":"邮袋终于收齐","FL09":"落石安了家","FL10":"两封信送达","FL11":"大家都到了","FL12":"守门人履约","FL17":"试炼的封印解开了","FL18":"芽眼醒了"}.get(level,"邻居的笑容"),preload("res://scripts/content/content_catalog.gd").region_for(level),speaker,reaction.trim_prefix(speaker+"："),"听听接下来的消息","","result"]
	if id.begins_with("puzzle_") and (level in MAIN or SETUPS.has(level)):
		return {"kind":"puzzle","level":level,"region":preload("res://scripts/content/content_catalog.gd").region_for(level)}
	if row.is_empty(): return {}
	return {"kind":"scene","title":row[0],"region":row[1],"speaker":row[2],"text":row[3],"action":row[4],"next":row[5],"effect":row[6],"level":level if level in MAIN or SETUPS.has(level) else ""}
