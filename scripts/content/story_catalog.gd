static func region_line(region: String, completed: Array) -> String:
	for entry in REGION_STORIES[region]:
		if entry[0] == "" or entry[0] in completed: return entry[1]
	return ""

static func camp_dialogue(completed: Array) -> String:
	for entry in [["FL18","camp.spring"],["FL12","camp.growth"],["FL08","camp.post"],["FL02","camp.moss"],["FL01","camp.delivery"]]:
		if entry[0] in completed: return entry[1]
	return "camp.begin"

static func region_dialogue_id(region: String, completed: Array) -> String:
	for entry in REGION_STORIES[region]:
		if entry[0] == "" or entry[0] in completed: return region+"/"+("begin" if entry[0] == "" else entry[0])
	return ""

static func region_dialogue(id: String) -> Dictionary:
	var parts = id.split("/")
	if parts.size() != 2 or not REGION_STORIES.has(parts[0]): return {}
	for entry in REGION_STORIES[parts[0]]:
		if parts[1] == ("begin" if entry[0] == "" else entry[0]): return {"requires":entry[0],"text":entry[1]}
	return {}

